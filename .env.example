# Base RPC URL (you can use public RPC or Alchemy/Infura)
BASE_RPC_URL=https://mainnet.base.org

# Amount to quote (in WETH, e.g., 1.0 = 1 WETH)
QUOTE_AMOUNT=1.0

# Minimum profit threshold in USD to execute arbitrage
MIN_PROFIT_USD=10

# Scan interval in milliseconds (0 = run once, default: 30000 = 30s)
SCAN_INTERVAL_MS=30000

# Directory to save JSON logs
LOG_DIR=logs
